# Copy to .env.local and fill in. Never commit real values.

# Data source: "memory" (fictional fixtures, safe for testing) or "airtable"
ATLAS_DATA_SOURCE=memory

# Airtable (server-side only; never exposed to the browser)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appygHLmJTH1ew5r6

# Session signing secret: at least 32 random characters (e.g. `openssl rand -hex 32`)
ATLAS_SESSION_SECRET=

# Users: JSON array of {id, email, name, role, passwordHash, customerId?}
# role is one of: owner, manager, sales, supervisor, worker, customer
# Generate a hash with: npm run hash-password -- 'the-password'
ATLAS_USERS_JSON=

# Optional integrations (stay "not connected" until set and tested)
ANTHROPIC_API_KEY=
ATLAS_AI_MODEL=claude-opus-5-5
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=sandbox

# Optional: JSON overrides for business settings (markup, GST, schedules...). See docs/FINANCIAL_RULES.md
ATLAS_SETTINGS_JSON=
# Local dev only: keep memory-mode edits in data/local-store.json between restarts
ATLAS_MEMORY_PERSIST=0
